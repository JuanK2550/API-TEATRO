PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100

# Claves de los clientes que consumen /api. Solo se guarda su hash en memoria
API_KEY_POSTMAN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_TAQUILLA=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_WEB=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_MOVIL=REEMPLAZAR_CON_API_KEY_SEGURA

# Firma de los JWT que entrega el login
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_SEGURO
JWT_EXPIRES_IN=1h

# Administrador inicial. Se crea al arrancar si todavía no existe.
# La contraseña vive solo aquí: nunca se escribe en el código ni se imprime.
ADMIN_NOMBRE=Administrador Teatro
ADMIN_EMAIL=admin@teatro.com
ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO
