PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100

# Claves de los clientes que consumen /api. Solo se guarda su hash en memoria
API_KEY_POSTMAN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_TAQUILLA=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_WEB=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_MOVIL=REEMPLAZAR_CON_API_KEY_SEGURA

# Firma de los JWT que entrega el login
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_SEGURO
JWT_EXPIRES_IN=1h

# Primer administrador. SOLO las usa `npm run seed:admin`, que se ejecuta una
# vez al instalar. Arrancar la API no crea ninguna cuenta y no necesita estas
# tres variables: una vez creado el administrador se pueden retirar del entorno
# de servicio, y en producción deberían venir de un gestor de secretos.
#
# La contraseña vive solo aquí, necesita 12 caracteres o más, y nunca se escribe
# en el código ni se imprime.
ADMIN_NOMBRE=Administrador Teatro
ADMIN_EMAIL=admin@teatro.com
ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO_DE_12_O_MAS

# Conexión con Supabase PostgreSQL (bloque 7). Viven solo en el .env:
# nunca en el repositorio, ni en capturas, ni en el frontend.
#
# La que usa la API: rol api_teatro, solo lee y escribe datos. No puede
# crear ni borrar tablas, y sí pasa por las políticas de seguridad de fila.
DATABASE_URL=postgresql://api_teatro:CONTRASENA@HOST:5432/postgres

# La del dueño, solo para crear o reiniciar la base con scripts/preparar-base.js.
DATABASE_URL_ADMIN=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres

# Opcional. Un proyecto de Supabase APARTE, solo para las pruebas BA08 y BA09
# del bloque 8: esas dos exigen una base sin administradores, y dejar así la
# base de trabajo está prohibido. NUNCA se apunta aquí el proyecto de trabajo;
# el script compara los dos hosts y aborta si coinciden.
DATABASE_URL_PRUEBAS_ADMIN=postgresql://USUARIO:CONTRASENA@HOST_DE_PRUEBAS:5432/postgres
